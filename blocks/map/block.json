{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/map",
	"title": "Map",
	"category": "foxi-media",
	"description": "A Google map of your address. No API key needed.",
	"textdomain": "foxi-builder",
	"keywords": [
		"google maps",
		"location",
		"directions"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"address": {
			"type": "string",
			"default": "{{address}}"
		},
		"zoom": {
			"type": "number",
			"default": 14
		},
		"title": {
			"type": "string",
			"default": "Map"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"frame": "& .fx-map__frame"
		}
	}
}
