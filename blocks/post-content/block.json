{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/post-content",
	"title": "Post Content",
	"category": "foxi-site",
	"description": "The article itself, in blog post layouts: featured image and the post's text.",
	"textdomain": "foxi-builder",
	"keywords": [
		"article",
		"content",
		"body",
		"blog"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"featuredImage": {
			"type": "boolean",
			"default": true
		},
		"imageRatio": {
			"type": "string",
			"default": "16/9"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"multiple": false
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"image": "& .fx-post-content__image",
			"text": "& .fx-post-content__body",
			"headings": "& .fx-post-content__body :is(h2,h3,h4)",
			"link": "& .fx-post-content__body a"
		}
	}
}