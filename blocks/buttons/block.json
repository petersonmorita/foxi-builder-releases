{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/buttons",
	"title": "Buttons",
	"category": "foxi-content",
	"description": "A group of buttons side by side.",
	"textdomain": "foxi-builder",
	"keywords": [
		"cta",
		"group"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"stackMobile": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {}
	},
	"allowedBlocks": [
		"foxi/button"
	]
}
