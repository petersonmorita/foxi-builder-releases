{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/heading",
	"title": "Heading",
	"category": "foxi-content",
	"description": "A title with brand typography, highlights and an optional typewriter effect.",
	"textdomain": "foxi-builder",
	"keywords": [
		"title",
		"headline",
		"h1",
		"h2"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"tagName": {
			"type": "string",
			"default": ""
		},
		"typewriter": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"highlight": "& strong, & mark",
			"link": "& a",
			"typed": "& .fx-typed"
		}
	}
}
