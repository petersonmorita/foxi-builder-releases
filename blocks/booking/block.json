{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/booking",
	"title": "Booking Widget",
	"category": "foxi-interactive",
	"description": "Dates, guests and a button that send visitors to your booking engine. Choose a look, layout and placement.",
	"textdomain": "foxi-builder",
	"keywords": [
		"reservation",
		"hotel",
		"check in",
		"availability"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"url": {
			"type": "string",
			"default": "{{booking_url}}"
		},
		"arrivalParam": {
			"type": "string",
			"default": ""
		},
		"departureParam": {
			"type": "string",
			"default": ""
		},
		"guestsParam": {
			"type": "string",
			"default": ""
		},
		"maxGuests": {
			"type": "number",
			"default": 6
		},
		"showGuests": {
			"type": "boolean",
			"default": true
		},
		"buttonText": {
			"type": "string",
			"default": "Check availability"
		},
		"newTab": {
			"type": "boolean",
			"default": false
		},
		"labels": {
			"type": "object",
			"default": {
				"arrival": "Arrival",
				"departure": "Departure",
				"dates": "Check-in \u2013 Check-out",
				"guests": "Guests",
				"adults": "Adults",
				"children": "Children",
				"rooms": "Rooms",
				"promo": "Promo code"
			}
		},
		"icons": {
			"type": "boolean",
			"default": false
		},
		"dividers": {
			"type": "boolean",
			"default": false
		},
		"guestsWord": {
			"type": "boolean",
			"default": false
		},
		"buttonIcon": {
			"type": "string",
			"default": ""
		},
		"prefillDates": {
			"type": "boolean",
			"default": false
		},
		"adultsParam": {
			"type": "string",
			"default": ""
		},
		"childrenParam": {
			"type": "string",
			"default": ""
		},
		"roomsParam": {
			"type": "string",
			"default": ""
		},
		"promoParam": {
			"type": "string",
			"default": ""
		},
		"nightsParam": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": "bar"
		},
		"layout": {
			"type": "string",
			"default": "bar"
		},
		"mobileLayout": {
			"type": "string",
			"default": "stack"
		},
		"align": {
			"type": "string",
			"default": "stretch"
		},
		"overlap": {
			"type": "number",
			"default": 0
		},
		"fixed": {
			"type": "string",
			"default": "none"
		},
		"dates": {
			"type": "string",
			"default": "two"
		},
		"displayFormat": {
			"type": "string",
			"default": "short"
		},
		"minNights": {
			"type": "number",
			"default": 1
		},
		"guestMode": {
			"type": "string",
			"default": "total"
		},
		"guestUI": {
			"type": "string",
			"default": "select"
		},
		"maxChildren": {
			"type": "number",
			"default": 4
		},
		"rooms": {
			"type": "boolean",
			"default": false
		},
		"maxRooms": {
			"type": "number",
			"default": 5
		},
		"promo": {
			"type": "boolean",
			"default": false
		},
		"labelStyle": {
			"type": "string",
			"default": "above"
		},
		"iconStyle": {
			"type": "string",
			"default": ""
		},
		"colors": {
			"type": "object",
			"default": {}
		},
		"radius": {
			"type": "string",
			"default": ""
		},
		"blur": {
			"type": "number",
			"default": 16
		},
		"placeholders": {
			"type": "object",
			"default": {
				"date": "Select date",
				"dates": "Add dates",
				"promo": "Enter code"
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"field": "& .fx-booking__field",
			"label": "& .fx-booking__label",
			"input": "& .fx-booking__input",
			"submit": "& .fx-booking__submit",
			"icon": "& .fx-booking__icon",
			"divider": "& .fx-booking__field + .fx-booking__field",
			"pop": "& .fx-booking__pop",
			"open": "& .fx-booking__open"
		}
	}
}
