{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/icon",
	"title": "Icon",
	"category": "foxi-content",
	"description": "A single icon with an optional shape behind it.",
	"textdomain": "foxi-builder",
	"keywords": [
		"symbol",
		"svg"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"icon": {
			"type": "string",
			"default": "lucide:star"
		},
		"shape": {
			"type": "string",
			"default": "none"
		},
		"link": {
			"type": "object",
			"default": {}
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"shape": "& .fx-icon__shape",
			"svg": "& .fx-svg"
		}
	}
}
