{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/flip-side",
	"title": "Flip Box side",
	"category": "foxi-interactive",
	"description": "The front or back of a flip box.",
	"textdomain": "foxi-builder",
	"keywords": [
		"flip"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"side": {
			"type": "string",
			"default": "front"
		},
		"vAlign": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"inner": "& > .fx-flip-side__inner",
			"overlay": "& > .fx-bg > .fx-bg__overlay"
		}
	},
	"parent": [
		"foxi/flip-box"
	]
}