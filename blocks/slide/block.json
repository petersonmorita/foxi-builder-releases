{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/slide",
	"title": "Slide",
	"category": "foxi-interactive",
	"description": "One slide of a Slider.",
	"textdomain": "foxi-builder",
	"keywords": [],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"vAlign": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"inner": "& > .fx-slide__inner",
			"overlay": "& > .fx-bg > .fx-bg__overlay"
		}
	},
	"parent": [
		"foxi/slider"
	]
}
