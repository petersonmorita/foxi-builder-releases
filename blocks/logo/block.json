{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/logo",
	"title": "Logo",
	"category": "foxi-site",
	"description": "Your logo, linked to the home page.",
	"textdomain": "foxi-builder",
	"keywords": [
		"brand",
		"site title"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"source": {
			"type": "string",
			"default": "business"
		},
		"image": {
			"type": "object",
			"default": {}
		},
		"altImage": {
			"type": "object",
			"default": {}
		},
		"text": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"img": "& .fx-logo__img",
			"text": "& .fx-logo__text"
		}
	}
}
