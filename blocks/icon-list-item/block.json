{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/icon-list-item",
	"title": "List Item",
	"category": "foxi-content",
	"description": "One item of an Icon List.",
	"textdomain": "foxi-builder",
	"keywords": [],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"icon": "& .fx-icon-list__icon",
			"text": "& .fx-icon-list__text"
		}
	},
	"parent": [
		"foxi/icon-list"
	],
	"usesContext": [
		"foxi/listIcon"
	]
}
