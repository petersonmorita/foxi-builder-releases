{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/row",
	"title": "Columns",
	"category": "foxi-layout",
	"description": "Lay content out in responsive columns.",
	"textdomain": "foxi-builder",
	"keywords": [
		"row",
		"grid",
		"columns",
		"layout"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"vAlign": {
			"type": "string",
			"default": "stretch"
		},
		"reverseMobile": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {}
	}
}
