{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/slider",
	"title": "Slider",
	"category": "foxi-interactive",
	"description": "Full-width slides with backgrounds, text and buttons.",
	"textdomain": "foxi-builder",
	"keywords": [
		"hero",
		"slideshow",
		"banner"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"delay": {
			"type": "number",
			"default": 6000
		},
		"speed": {
			"type": "number",
			"default": 800
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"effect": {
			"type": "string",
			"default": "fade"
		},
		"arrows": {
			"type": "boolean",
			"default": true
		},
		"dots": {
			"type": "boolean",
			"default": true
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"slide": "& .fx-slide",
			"arrow": "& .fx-slider__arrow",
			"dot": "& .swiper-pagination-bullet",
			"dotActive": "& .swiper-pagination-bullet-active"
		}
	},
	"allowedBlocks": [
		"foxi/slide"
	]
}
