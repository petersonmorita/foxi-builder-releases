{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/header-row",
	"title": "Header Row",
	"category": "foxi-site",
	"description": "A row of the header with a ready-made layout (logo left, centred, etc.).",
	"textdomain": "foxi-builder",
	"keywords": [],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"default": "logo-left"
		},
		"role": {
			"type": "string",
			"default": "main"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"inner": "& > .fx-header-row__inner"
		}
	},
	"parent": [
		"foxi/header"
	]
}
