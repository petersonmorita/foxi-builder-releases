{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "foxi/section",
	"title": "Section",
	"category": "foxi-layout",
	"description": "A full-width band of the page with backgrounds, video, overlays and shape dividers.",
	"textdomain": "foxi-builder",
	"keywords": [
		"container",
		"band",
		"hero",
		"background"
	],
	"attributes": {
		"fx": {
			"type": "object",
			"default": {}
		},
		"tagName": {
			"type": "string",
			"default": "section"
		},
		"width": {
			"type": "string",
			"default": "boxed"
		},
		"height": {
			"type": "string",
			"default": "auto"
		},
		"vAlign": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true
	},
	"style": "foxi-blocks",
	"foxi": {
		"elements": {
			"inner": "& > .fx-section__inner",
			"overlay": "& > .fx-bg > .fx-bg__overlay",
			"shapeTop": "& > .fx-shape--top",
			"shapeBottom": "& > .fx-shape--bottom"
		}
	}
}
